# GooseJobs AI backend URL
# Local dev: http://localhost:8000
# Production (HuggingFace Space): https://mourad675-goose-job-ai.hf.space
BACKEND_URL=http://localhost:8000

# HuggingFace access token — required if the HF Space is private
# Get one from https://huggingface.co/settings/tokens
HF_ACCESS_TOKEN=

# Internal API key passed to all backend proxy routes (x-internal-key header)
INTERNAL_API_KEY=

# Full site URL — needed for SEO metadata and sitemap in production
# Example: https://goosejobs.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional access-code gate. If set, users must enter this code at /enter
# before accessing the app. Leave blank to disable the gate.
ACCESS_CODE=

# === Error tracking (optional) ===
# Leave the DSNs empty to disable Sentry entirely (no-op).
# SENTRY_DSN            — server/edge runtime error reporting.
# NEXT_PUBLIC_SENTRY_DSN — browser error reporting (exposed to the client).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
# Source-map upload (CI/production only). Without these, builds skip upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
